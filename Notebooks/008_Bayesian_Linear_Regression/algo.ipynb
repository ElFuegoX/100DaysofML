        "    'sulphates': 'sulphates',\n",
        "    'alcohol': 'alcohol'\n",
        "})\n",
        "\n",
        "# Entraîner le modèle bayésien\n",
        "model_bayes = bmb.Model('quality ~ fixed_acidity + volatile_acidity + citric_acid + chlorides + total_sulfur_dioxide + density + pH + sulphates + alcohol',\n",
